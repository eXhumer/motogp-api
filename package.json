{
  "name": "@exhumer/motogp-api",
  "version": "0.1.0",
  "description": "Unofficial MotoGP API client for JavaScript/TypeScript: sign-in, live timing snapshots, sessions, results and live video streams",
  "keywords": [
    "motogp",
    "moto2",
    "moto3",
    "motorsport",
    "video-pass",
    "timing",
    "api",
    "api-client",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "eXhumer",
    "email": "github@exhumer.cc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eXhumer/motogp-api.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.19.0"
    },
    "packageManager": {
      "name": "npm"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --reporter=junit --outputFile=test-report.junit.xml",
    "probe": "node scripts/probe-endpoints.mjs",
    "record-live": "node scripts/record-live.mjs",
    "verify": "node scripts/verify.mjs",
    "gen-schema": "node scripts/gen-schema.mjs",
    "make-fixtures": "node scripts/make-fixtures.mjs",
    "contract": "node scripts/contract.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "jose": "^6.2.12",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "@exhumer/motogp-auth": "^0.1.0",
    "undici": "^8.12.2"
  }
}
